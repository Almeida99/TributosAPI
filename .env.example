# ============================================================
# TributosAPI — variáveis de ambiente (produção)
# Bancos/municípios: cadastrar em /config/bancos (não no .env)
# ============================================================

# Driver ODBC padrão
DB_DRIVER=ODBC Driver 18 for SQL Server

# TLS ODBC (padrão seguro: Encrypt=yes)
DB_ENCRYPT=yes
# Use "yes" se o SQL Server tiver certificado autoassinado
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Segurança do catálogo multibanco (OBRIGATÓRIO para gravar bancos) ---
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANCOS_SECRET_KEY=

# --- HTTP Basic administrativo (OBRIGATÓRIO) ---
# Protege a home, todo o painel, a execução interna e /config.
# A API externa em /{slug}/api/v1 continua autenticada por JWT.
CONFIG_ADMIN_USER=admin
CONFIG_ADMIN_PASSWORD=troque_esta_senha

# --- API de terceiros (JWT) ---
API_JWT_SECRET=troque_por_segredo_longo_aleatorio
API_TOKEN_EXPIRE_MINUTES=60
API_ORCHESTRATOR_USR_COD=1
API_ADMIN_KEY=troque_esta_chave_admin

# API_HOST=0.0.0.0
# API_PORT=8000
